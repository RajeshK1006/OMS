# ============ Secrets — NEVER commit these ============
# Environment-specific overrides (real servers, passwords, keys).
# Base appsettings.json + appsettings.Development.json stay tracked:
# they contain only localhost + Windows-auth (Trusted_Connection) defaults.
appsettings.Production.json
appsettings.Staging.json
appsettings.UAT.json
appsettings.Local.json
secrets.json
appsettings.*.secrets.json
.env
.env.*
*.pfx
*.p12
*.key
*.pem
azurekeyvault.json



