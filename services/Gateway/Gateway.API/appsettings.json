{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Services": {
      "Ordering": {
        "BaseUrl": "http://localhost:5196",
        "Paths": {
          "Orders": "/api/orders",
          "OrderById": "/api/orders/{id}"
        }
      },
      "Identity": { "BaseUrl": "http://localhost:5090", "Paths": {} },
      "Catalog": { "BaseUrl": "http://localhost:5271", "Paths": {} },
      "Inventory": { "BaseUrl": "http://localhost:5147", "Paths": {} },
      "Customer": { "BaseUrl": "http://localhost:5007", "Paths": {} },
      "Payment": { "BaseUrl": "http://localhost:5034", "Paths": {} },
      "Fulfillment": { "BaseUrl": "http://localhost:5123", "Paths": {} },
      "Returns": { "BaseUrl": "http://localhost:5197", "Paths": {} },
      "Procurement": { "BaseUrl": "http://localhost:5125", "Paths": {} },
      "Notification": { "BaseUrl": "http://localhost:5063", "Paths": {} },
      "Reporting": { "BaseUrl": "http://localhost:5076", "Paths": {} }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "swagger-identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/swagger/identity/swagger.json" },
        "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }]
      },
      "swagger-catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/swagger/catalog/swagger.json" },
        "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }]
      },
      "swagger-ordering": {
        "ClusterId": "ordering",
        "Match": { "Path": "/swagger/ordering/swagger.json" },
        "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }]
      },
      "swagger-inventory": {
        "ClusterId": "inventory",
        "Match": { "Path": "/swagger/inventory/swagger.json" },
        "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }]
      },
      "swagger-customer": {
        "ClusterId": "customer",
        "Match": { "Path": "/swagger/customer/swagger.json" },
        "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }]
      },
      "swagger-payment": {
        "ClusterId": "payment",
        "Match": { "Path": "/swagger/payment/swagger.json" },
        "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }]
      },
      "swagger-fulfillment": {
        "ClusterId": "fulfillment",
        "Match": { "Path": "/swagger/fulfillment/swagger.json" },
        "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }]
      },
      "swagger-returns": {
        "ClusterId": "returns",
        "Match": { "Path": "/swagger/returns/swagger.json" },
        "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }]
      },
      "swagger-procurement": {
        "ClusterId": "procurement",
        "Match": { "Path": "/swagger/procurement/swagger.json" },
        "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }]
      },
      "swagger-notification": {
        "ClusterId": "notification",
        "Match": { "Path": "/swagger/notification/swagger.json" },
        "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }]
      },
      "swagger-reporting": {
        "ClusterId": "reporting",
        "Match": { "Path": "/swagger/reporting/swagger.json" },
        "Transforms": [{ "PathSet": "/swagger/v1/swagger.json" }]
      }
    },
    "Clusters": {
      "ordering": {
        "Destinations": {
          "ordering1": { "Address": "http://localhost:5196/" }
        }
      },
      "identity": {
        "Destinations": {
          "identity1": { "Address": "http://localhost:5090/" }
        }
      },
      "catalog": {
        "Destinations": {
          "catalog1": { "Address": "http://localhost:5271/" }
        }
      },
      "inventory": {
        "Destinations": {
          "inventory1": { "Address": "http://localhost:5147/" }
        }
      },
      "customer": {
        "Destinations": {
          "customer1": { "Address": "http://localhost:5007/" }
        }
      },
      "payment": {
        "Destinations": {
          "payment1": { "Address": "http://localhost:5034/" }
        }
      },
      "fulfillment": {
        "Destinations": {
          "fulfillment1": { "Address": "http://localhost:5123/" }
        }
      },
      "returns": {
        "Destinations": {
          "returns1": { "Address": "http://localhost:5197/" }
        }
      },
      "procurement": {
        "Destinations": {
          "procurement1": { "Address": "http://localhost:5125/" }
        }
      },
      "notification": {
        "Destinations": {
          "notification1": { "Address": "http://localhost:5063/" }
        }
      },
      "reporting": {
        "Destinations": {
          "reporting1": { "Address": "http://localhost:5076/" }
        }
      }
    }
  }
}
